{
  "name": "dsh-sleuth-copilot",
  "version": "0.10.1",
  "private": true,
  "description": "ascend-sleuth 诊断交互层：状态条、诊断总览、一键复制指令与收尾/重开/沉淀状态写入",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "meta": {
    "title": "ascend-sleuth 诊断状态条",
    "description": "输入框上方的诊断状态、诊断总览与一键动作：读状态、复制指令、收尾/重开/沉淀状态写入。"
  }
}
